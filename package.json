{
  "name": "3d-assembly-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touchscreen 3D assembly game -- objects joined by mate connectors.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:usb": "node scripts/dev-usb.mjs",
    "dev:usb:bare": "vite --host 127.0.0.1",
    "mirror": "node scripts/mirror.mjs",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test",
    "test:quick": "vitest run --exclude tests/d170_regenerate.test.ts --exclude tests/d170_fresh_plan.test.ts",
    "verify:quick": "npm run typecheck && npm run test:quick"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
